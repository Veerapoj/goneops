NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goneops
POSTGRES_USER=goneops
POSTGRES_PASSWORD=change-me-locally

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=goneops
RABBITMQ_DEFAULT_PASS=change-me-locally

# Local self-hosted source control and CI/CD
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001/
GITEA_URL=http://localhost:3001
GITEA_PORT=3001
GITEA_SSH_PORT=2222
WOODPECKER_HOST=http://localhost:8000
WOODPECKER_URL=http://localhost:8000
WOODPECKER_PORT=8000
WOODPECKER_AGENT_SECRET=change-me-locally

# QuickStart live automation (tokens stay local; never commit real values)
QUICKSTART_LIVE_AUTOMATION=true
QUICKSTART_WORKSPACE_DIR=.goneops/quickstart-projects
GITEA_OWNER=goneops
GITEA_TOKEN=
WOODPECKER_TOKEN=
